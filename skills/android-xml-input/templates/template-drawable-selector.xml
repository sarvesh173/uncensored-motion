<?xml version="1.0" encoding="utf-8"?>
<!--
  SELECTOR TEMPLATE (state list drawable) - placement: res/drawable/tpl_button_selector.xml.
  Order matters: first matching state wins, so special states go BEFORE the fallback.
  Structure follows the real Gold Motion selector nesting pattern
  (res/drawable/round_rect6dp_border_r2.xml: state_enabled shape + fallback shape with
  stroke) and the four-state selector_tab_wheel.xml. Referenced by
  template-values-styles.xml (TplButton), template-layout-constraintlayout.xml, and
  template-layout-linearlayout.xml. Colors from template-values-colors.xml.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled: flat, muted surface (real pattern: state_enabled="false" shape) -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tpl_corner_radius" />
            <solid android:color="@color/tpl_color_surface_light" />
            <stroke android:width="1dp" android:color="@color/tpl_color_divider" />
        </shape>
    </item>

    <!-- Pressed: gold-tinted feedback -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tpl_corner_radius" />
            <solid android:color="@color/tpl_color_ripple" />
        </shape>
    </item>

    <!-- Focused (keyboard/D-pad): accent border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tpl_corner_radius" />
            <solid android:color="@color/tpl_color_surface_light" />
            <stroke android:width="2dp" android:color="@color/tpl_color_gold" />
        </shape>
    </item>

    <!-- Default resting state: MUST be last (real pattern: bare <item> fallback) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tpl_corner_radius" />
            <solid android:color="@color/tpl_color_primary" />
        </shape>
    </item>
</selector>
