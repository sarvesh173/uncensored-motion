<?xml version="1.0" encoding="utf-8"?>
<!--
  VECTOR TEMPLATE - placement: res/drawable/ic_vector_placeholder.xml
  (the file name IS the resource name: @drawable/ic_vector_placeholder - used by all three
  layout templates and by TplTheme.App.Starting in the styles template, and
  content-described by @string/tpl_cd_icon).
  24dp square in a 24-unit viewport - the same shape as the real ic_snap2.xml and
  ic_giftbox-style vectors in the APK (24dp box, dp-declared size, pathData in SVG
  syntax). Glyph: a five-point star on a dark plate, gold like the real Y1 accent
  (#fff6c945). Tintable at runtime with android:tint / app:tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Dark plate (rounded square, real A9 panel tone) -->
    <path
        android:fillColor="#ff202332"
        android:pathData="M4,4h16c1.1,0 2,0.9 2,2v12c0,1.1 -0.9,2 -2,2H4c-1.1,0 -2,-0.9 -2,-2V6C2,4.9 2.9,4 4,4z" />

    <!-- Inner subtle border (group with slight inset via scale) -->
    <group
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:pivotX="12"
        android:pivotY="12">
        <path
            android:fillColor="#80ffffff"
            android:pathData="M4,4h16v16H4z" />
    </group>

    <!-- Gold star glyph (Y1 from the real colors.xml) -->
    <path
        android:fillColor="#fff6c945"
        android:pathData="M12,3.2l2.47,5.1 5.63,0.77 -4.13,3.95 1.02,5.58L12,15.9l-4.99,2.7 1.02,-5.58 -4.13,-3.95 5.63,-0.77z" />
</vector>
